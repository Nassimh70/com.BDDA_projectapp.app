```mermaid
classDiagram
    direction LR

    class adresse_type {
        <<object>>
        +Number num_rue
        +String rue
        +String ville
        +String cp
    }

    class tel_vry_type {
        <<VARRAY(3) of VARCHAR2>>
        domicile
        portable1
        portable2
    }

    class conseiller_type {
        <<object>>
        +Number num_conseiller
        +String nom
        +String prenom
        +String specialite
        +Date date_embauche
        +Number salaire
    }

    class agence_type {
        <<object>>
        +String code
        +String nom
        +String ville
        +REF ref_responsable
    }

    class client_type {
        <<object>>
        +Number num_client
        +String nom
        +String prenom
        +Date date_naissance
        +String num_secu
        +adresse_type adresse
        +tel_vry_type telephones
        +String email
        +Date date_entree
        +REF ref_conseiller
        +REF ref_parrain
        +nbCepargne() Number
        +soldeTotal() Number
        +supprimeTel(indice)
        +afficheInterets()
    }

    class compte_type {
        <<abstract, NOT FINAL, NOT INSTANTIABLE>>
        +String num_compte
        +Number solde
        +Date date_ouverture
        +String statut
        +REF ref_client
        +REF ref_agence
        +fraisTenue() Number
        +fermeCompte(cpt)$
    }

    class cptCourant_type {
        <<object>>
        +Number decouvert
        +Number nb_op_cb
        +signataire_nt_type signataires
        +nbSignataire() Number
        +nbSignataire(droit) Number
        +estTitulaire(cli) Boolean
        +estSignataire(cli, droit) Boolean
        +supprimeSign(nclient)
        +passeMvt(cli, somme)
        +peutRetirer(cli, somme) Boolean
    }

    class cptEpargne_type {
        <<object>>
        +Number taux_interet
        +Number plafond_depot
        +calculeInterets() Number
        +sortieAnticipee() Number
    }

    class cptTerme_type {
        <<object>>
        +Number montant_bloque
        +Number duree_mois
        +Date date_echeance
        +Number taux_garanti
        +calculeInterets() Number
        +sortieAnticipee() Number
    }

    class signataire_elt_nt_type {
        <<nested table element>>
        +char droit
    }

    class operation_type {
        <<object>>
        +Number id_op
        +Date date_op
        +Number montant
        +String type_op
        +Number commission
    }

    class affectation {
        <<relationnelle>>
        +Number id_affectation
        +Date date_debut
        +Date date_fin
    }

    class type_stat_elt_nt_type {
        <<object>>
        +String type_op
        +Number nb
        +Number montant_total
    }

    class mois_elt_vry_type {
        <<object>>
        +Number mois
        +Number nb_operations
        +type_stat_nt_type types
    }

    class releves {
        <<relationnelle>>
        +Number annee
        +mois_vry_type mois_vry
    }

    class agence_vor_type {
        <<object, vue>>
        +String code
        +String nom
        +conseiller_nt_type conseillers
        +cptCourant_nt_type comptes
        +mutation(nConseiller, nAgenceCible)
    }

    compte_type <|-- cptCourant_type
    compte_type <|-- cptEpargne_type
    compte_type <|-- cptTerme_type

    client_type "1" --> "0..1" client_type : parrain
    client_type "1" --> "0..1" conseiller_type : conseiller attitre
    agence_type "1" --> "1" conseiller_type : responsable
    conseiller_type "1" --> "0..*" affectation : historique
    agence_type "1" --> "0..*" affectation : affecte a

    client_type "1" --> "0..*" compte_type : titulaire
    agence_type "1" --> "0..*" compte_type : domiciliation

    compte_type "1" --> "0..*" operation_type : mouvements
    client_type "1" --> "0..*" operation_type : auteur

    cptCourant_type "1" *-- "0..*" signataire_elt_nt_type : signataires
    client_type "1" --> "0..*" signataire_elt_nt_type : est signataire

    client_type "1" *-- "0..3" tel_vry_type : telephones
    client_type "1" *-- "1" adresse_type : adresse

    releves "1" *-- "0..12" mois_elt_vry_type : mois_vry
    mois_elt_vry_type "1" *-- "0..*" type_stat_elt_nt_type : types
    agence_vor_type "1" *-- "0..*" conseiller_type : conseillers
    agence_vor_type "1" *-- "0..*" cptCourant_type : comptes
```
