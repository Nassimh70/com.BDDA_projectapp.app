@startuml banque
' =====================================================================
' Diagramme de classes - Mini-projet BDDA (banque)
' M1 ASR - Universite de Bejaia - 2026/2027
' A1 : hierarchie des comptes, associations et cardinalites,
'      classe d'association des signataires (droit), operations,
'      parrainage recursif, aggregation des telephones, methodes.
' =====================================================================

skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 45
hide circle
hide empty members

' ---------------------------------------------------------------------
' Types "valeur"
' ---------------------------------------------------------------------
class adresse_type <<object>> {
  + num_rue : NUMBER
  + rue : VARCHAR2(80)
  + ville : VARCHAR2(40)
  + cp : VARCHAR2(10)
}

class tel_vry_type <<VARRAY(3) OF VARCHAR2(20)>> {
  [1] domicile
  [2] portable 1
  [3] portable 2
}

' ---------------------------------------------------------------------
' Individus et structures
' ---------------------------------------------------------------------
class conseiller_type <<object>> {
  + num_conseiller : NUMBER
  + nom : VARCHAR2(30)
  + prenom : VARCHAR2(30)
  + specialite : VARCHAR2(40)
  + date_embauche : DATE
  + salaire : NUMBER(10,2)
}

class agence_type <<object>> {
  + code : VARCHAR2(6)
  + nom : VARCHAR2(40)
  + ville : VARCHAR2(40)
  + ref_responsable : REF conseiller_type
}

class client_type <<object>> {
  + num_client : NUMBER
  + nom : VARCHAR2(30)
  + prenom : VARCHAR2(30)
  + date_naissance : DATE
  + num_secu : VARCHAR2(20)
  + adresse : adresse_type
  + telephones : tel_vry_type
  + email : VARCHAR2(60)
  + date_entree : DATE
  + ref_conseiller : REF conseiller_type
  + ref_parrain : REF client_type
  + nbCepargne() : NUMBER
  + soldeTotal() : NUMBER
  + supprimeTel(indice : NUMBER)
  + afficheInterets()
}

class affectation <<relationnelle>> {
  + id_affectation : NUMBER
  + date_debut : DATE
  + date_fin : DATE
}

' ---------------------------------------------------------------------
' Hierarchie des comptes
' ---------------------------------------------------------------------
abstract class compte_type <<NOT FINAL, NOT INSTANTIABLE>> {
  + num_compte : VARCHAR2(10)
  + solde : NUMBER(12,2)
  + date_ouverture : DATE
  + statut : VARCHAR2(10)
  + ref_client : REF client_type
  + ref_agence : REF agence_type
  + fraisTenue() : NUMBER
  + {static} fermeCompte(cpt : VARCHAR2)
}

class cptCourant_type <<object>> {
  + decouvert : NUMBER(12,2)
  + nb_op_cb : NUMBER
  + signataires : signataire_nt_type
  + nbSignataire() : NUMBER
  + nbSignataire(droitparam : CHAR) : NUMBER
  + estTitulaire(cli : NUMBER) : BOOLEAN
  + estSignataire(cli : NUMBER, droitparam : CHAR) : BOOLEAN
  + supprimeSign(nclient : NUMBER)
  + passeMvt(cli : NUMBER, somme : NUMBER)
  + peutRetirer(cli : NUMBER, somme : NUMBER) : BOOLEAN
}

class cptEpargne_type <<object>> {
  + taux_interet : NUMBER(5,2)
  + plafond_depot : NUMBER(12,2)
  + calculeInterets() : NUMBER
  + sortieAnticipee() : NUMBER
}

class cptTerme_type <<object>> {
  + montant_bloque : NUMBER(12,2)
  + duree_mois : NUMBER
  + date_echeance : DATE
  + taux_garanti : NUMBER(5,2)
  + calculeInterets() : NUMBER
  + sortieAnticipee() : NUMBER
}

' ---------------------------------------------------------------------
' Signataires : classe d'association avec attribut "droit"
' ---------------------------------------------------------------------
class signataire_elt_nt_type <<object, nested table element>> {
  + droit : CHAR(1) {R, D, X}
}

' ---------------------------------------------------------------------
' Operations : association n-aire (client, compte, date)
' ---------------------------------------------------------------------
class operation_type <<object>> {
  + id_op : NUMBER
  + date_op : DATE
  + montant : NUMBER(12,2)
  + type_op : VARCHAR2(10)
  + commission : NUMBER(12,2)
}

' ---------------------------------------------------------------------
' Collections multi-niveaux (E11) et vue objet (E12)
' ---------------------------------------------------------------------
class type_stat_elt_nt_type <<object>> {
  + type_op : VARCHAR2(10)
  + nb : NUMBER
  + montant_total : NUMBER(14,2)
}

class mois_elt_vry_type <<object>> {
  + mois : NUMBER
  + nb_operations : NUMBER
  + types : type_stat_nt_type
}

class releves <<relationnelle>> {
  + annee : NUMBER
  + mois_vry : mois_vry_type
}

class agence_vor_type <<object, vue>> {
  + code : VARCHAR2(6)
  + nom : VARCHAR2(40)
  + conseillers : conseiller_nt_type
  + comptes : cptCourant_nt_type
  + mutation(nConseiller : NUMBER, nAgenceCible : VARCHAR2)
}

' ---------------------------------------------------------------------
' Heritages
' ---------------------------------------------------------------------
compte_type <|-- cptCourant_type
compte_type <|-- cptEpargne_type
compte_type <|-- cptTerme_type

' ---------------------------------------------------------------------
' Associations et cardinalites
' ---------------------------------------------------------------------
client_type "1" --> "0..1" client_type : parrain
client_type "1" --> "0..1" conseiller_type : conseiller attitre
agence_type "1" --> "1" conseiller_type : responsable
conseiller_type "1" -- "0..*" affectation : historique
agence_type "1" -- "0..*" affectation : affecte a

client_type "1" --> "0..*" compte_type : titulaire
agence_type "1" --> "0..*" compte_type : domiciliation

compte_type "1" --> "0..*" operation_type : mouvements
client_type "1" --> "0..*" operation_type : auteur

cptCourant_type "1" *-- "0..*" signataire_elt_nt_type : signataires
client_type "1" --> "0..*" signataire_elt_nt_type : est signataire

client_type "1" *-- "0..3" tel_vry_type : telephones
client_type "1" *-- "1" adresse_type : adresse

releves "1" *-- "0..12" mois_elt_vry_type : mois_vry
mois_elt_vry_type "1" *-- "0..*" type_stat_elt_nt_type : types
agence_vor_type "1" *-- "0..*" conseiller_type : conseillers
agence_vor_type "1" *-- "0..*" cptCourant_type : comptes

note right of compte_type
  compte_type est NOT FINAL NOT INSTANTIABLE :
  aucun compte generique n'est stocke.
  3 tables objet : cpt_courant, cpt_epargne, cpt_terme.
  fraisTenue() est redefinie (OVERRIDING) dans les 3 sous-types.
end note

note bottom of signataire_elt_nt_type
  Le droit est porte par la classe d'association :
  R = consultation, D = depot/retrait, X = tous pouvoirs.
  Contrainte CHECK (droit IN ('X','R','D')) sur la table de stockage.
end note

note bottom of operation_type
  Association n-aire : un client realise une operation
  sur un compte courant, a une date donnee.
  montant > 0 credit, montant < 0 debit.
end note

@enduml
