% =====================================================================
% uml_banque.tikz — diagramme de classes UML synthétique
% À inclure dans un environnement landscape ou une figure pleine page.
% =====================================================================
\begin{tikzpicture}[
  x=1cm, y=1cm,
  class/.style={
    draw=navy, fill=blue!4, rounded corners=2pt,
    align=left, font=\scriptsize, inner sep=4pt,
    text width=3.55cm, line width=0.6pt
  },
  note/.style={
    draw=grayText, fill=grayLight, rounded corners=2pt,
    align=left, font=\scriptsize, inner sep=3pt,
    text width=3.55cm, line width=0.4pt
  },
  assoc/.style={draw=navy, line width=0.6pt},
  inher/.style={draw=navy, line width=0.6pt, -{Triangle[open,length=6pt,width=8pt]}},
  comp/.style={draw=navy, line width=0.6pt, -{Diamond[open,length=6pt,width=8pt]}},
  dep/.style={draw=grayText, line width=0.5pt, dashed, -{Stealth[length=5pt]}},
  lbl/.style={font=\tiny, fill=white, inner sep=1pt, text=grayText}
]

% ---------------------------------------------------------------------
% Individus et structures
% ---------------------------------------------------------------------
\node[class] (agence) at (2.4,13.4) {%
  \textbf{\color{navy}agence\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  code : VARCHAR2(6)\\
  nom, ville\\
  ref\_responsable : REF conseiller\_type\\[1pt]
  \textit{+ responsable()}
};

\node[class] (conseiller) at (8.4,13.4) {%
  \textbf{\color{navy}conseiller\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  num\_conseiller, nom, prénom\\
  spécialité, date\_embauche\\
  salaire\\[1pt]
  \textit{+ nbClients()}
};

\node[class] (client) at (15.4,13.4) {%
  \textbf{\color{navy}client\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  num\_client, nom, prénom\\
  adresse : adresse\_type\\
  téléphones : tel\_vry\_type\\
  ref\_conseiller, ref\_parrain\\[1pt]
  \textit{+ nbCepargne(), soldeTotal()}\\
  \textit{+ afficheInterets()}
};

\node[class] (affectation) at (5.4,9.6) {%
  \textbf{\color{navy}affectation}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  id\_affectation\\
  ref\_conseiller, ref\_agence\\
  date\_debut, date\_fin
};

\node[class] (compte) at (10.6,9.6) {%
  \textbf{\color{navy}compte\_type}\\[1pt]
  \textit{\color{grayText}« abstrait »}\\
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  num\_compte, solde, statut\\
  ref\_client, ref\_agence\\[1pt]
  \textit{+ fraisTenue()}\\
  \textit{+ fermeCompte() static}
};

% ---------------------------------------------------------------------
% Hiérarchie des comptes
% ---------------------------------------------------------------------
\node[class] (cptCourant) at (5.0,5.0) {%
  \textbf{\color{navy}cptCourant\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  découvert, nb\_op\_cb\\
  signataires : signataire\_nt\_type\\[1pt]
  \textit{+ peutRetirer(), passeMvt()}\\
  \textit{+ nbSignataire()}
};

\node[class] (cptEpargne) at (10.6,5.0) {%
  \textbf{\color{navy}cptEpargne\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  taux\_interet\\
  plafond\_depot\\[1pt]
  \textit{+ calculeInterets()}\\
  \textit{+ sortieAnticipee()}
};

\node[class] (cptTerme) at (16.2,5.0) {%
  \textbf{\color{navy}cptTerme\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  montant\_bloque, duree\_mois\\
  date\_echeance, taux\_garanti\\[1pt]
  \textit{+ calculeInterets()}\\
  \textit{+ sortieAnticipee()}
};

\node[class] (operation) at (5.0,0.9) {%
  \textbf{\color{navy}operation\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  id\_op, date\_op, montant\\
  type\_op, commission\\
  ref\_client, ref\_compte
};

\node[class] (signataire) at (10.2,0.9) {%
  \textbf{\color{navy}signataire\_elt\_nt\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  ref\_client : REF client\_type\\
  droit : CHAR(1)\\
  \textit{nested table : signataire\_nt\_type}
};

% ---------------------------------------------------------------------
% Types valeur et collections
% ---------------------------------------------------------------------
\node[class] (adresse) at (21.4,14.2) {%
  \textbf{\color{navy}adresse\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  num\_rue, rue\\
  ville, cp
};

\node[class] (telephone) at (21.4,11.7) {%
  \textbf{\color{navy}tel\_vry\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  VARRAY(3) OF VARCHAR2(20)\\
  \textit{domicile, portable 1, 2}
};

\node[class] (releves) at (21.4,8.6) {%
  \textbf{\color{navy}releves}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  annee : NUMBER\\
  mois\_vry : VARRAY(12)
};

\node[class] (mois) at (21.4,6.1) {%
  \textbf{\color{navy}mois\_elt\_vry\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  mois, nb\_operations\\
  types : type\_stat\_nt\_type
};

\node[class] (stat) at (21.4,3.5) {%
  \textbf{\color{navy}type\_stat\_elt\_nt\_type}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  type\_op, nb\\
  montant\_total
};

% ---------------------------------------------------------------------
% Vue objet
% ---------------------------------------------------------------------
\node[class, dashed] (vue) at (17.6,9.6) {%
  \textbf{\color{navy}« vue » Agence\_VOR}\\[1pt]
  \textcolor{navy}{\rule{3.15cm}{0.3pt}}\\[1pt]
  code, nom, ville, ref\_responsable\\
  conseillers : conseiller\_nt\_type\\
  comptes : cptCourant\_nt\_type\\[1pt]
  \textit{+ mutation()}
};

% ---------------------------------------------------------------------
% Associations
% ---------------------------------------------------------------------
% Agence - conseiller (responsable)
\draw[assoc] (agence.east) -- node[lbl,above]{1} node[lbl,below]{0..1} (conseiller.west);
% Conseiller - client (suivi)
\draw[assoc] (conseiller.east) -- node[lbl,above]{1} node[lbl,below]{0..*} (client.west);
% Agence - affectation
\draw[assoc] (agence.south) -- node[lbl,left]{1} node[lbl,right]{0..*} (affectation.north);
% Conseiller - affectation
\draw[assoc] (conseiller.south) -- node[lbl,right]{1} node[lbl,left]{0..*} (affectation.north east);
% Client - compte
\draw[assoc] (client.south) -- node[lbl,right]{1} node[lbl,left]{0..*} (compte.north east);
% Agence - compte
\draw[assoc] (agence.south east) -- node[lbl,above]{1} node[lbl,below]{0..*} (compte.north west);
% Client - adresse / téléphones
\draw[comp] (client.east) -- node[lbl,above]{1} node[lbl,below]{1} (adresse.west);
\draw[comp] (client.east) -- node[lbl,above]{1} node[lbl,below]{1} (telephone.west);
% Parrainage récursif
\draw[assoc] (client.east) .. controls +(1.3,0.7) and +(1.3,-0.7) ..
  node[lbl,right]{0..1 parrain} (client.east);
% Héritage
\draw[inher] (cptCourant.north) -- (compte.south);
\draw[inher] (cptEpargne.north) -- (compte.south);
\draw[inher] (cptTerme.north) -- (compte.south);
% Compte courant - opérations
\draw[assoc] (cptCourant.south) -- node[lbl,left]{1} node[lbl,right]{0..*} (operation.north);
% Compte courant - signataires (nested table)
\draw[comp] (cptCourant.south east) -- node[lbl,above]{1} node[lbl,below]{0..*} (signataire.north west);
% Relevés multi-niveaux
\draw[comp] (releves.south) -- (mois.north);
\draw[comp] (mois.south) -- (stat.north);
% Vue objet
\draw[dep] (vue.west) -- node[lbl,above]{vue} (compte.east);

% ---------------------------------------------------------------------
% Légende
% ---------------------------------------------------------------------
\node[note, text width=7.5cm] at (13.2,2.0) {%
  \textbf{Légende.} Trait plein : association ; losange : composition ;
  triangle ouvert : héritage ; pointillés : dépendance de vue.
  Le détail des attributs et des méthodes est donné dans les tableaux
  du chapitre 2 et dans le source PlantUML \texttt{uml/banque.puml}.
};

\end{tikzpicture}
